<ui:FluentWindow x:Class="LaserMesh.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:LaserMesh.Studio"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    Title="LaserMesh Studio" Width="1440" Height="900" MinWidth="960" MinHeight="680"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
    Background="{StaticResource BaseBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <ui:FluentWindow.Resources>
        <Style TargetType="local:NumericInput" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PanelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="InspectorLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LaserMesh Studio" Background="{StaticResource ChromeBrush}"/>
        <Menu Grid.Row="1" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
              VerticalContentAlignment="Center" Padding="8,0">
            <MenuItem Header="_Proyecto">
                <MenuItem Header="_Nuevo" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Abrir…" Command="{Binding OpenCommand}"/>
                <MenuItem Header="_Recientes" ItemsSource="{Binding RecentPaths}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <EventSetter Event="Click" Handler="OnRecentClick"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Importar STL…" Command="{Binding ImportCommand}"/>
                <MenuItem Header="_Guardar" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Guardar _como…" Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="_Cerrar proyecto" Command="{Binding CloseProjectCommand}"/>
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="Deshacer" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
                <MenuItem Header="Rehacer" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
                <MenuItem Header="Seleccionar todo" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="Duplicar selección" Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="Quitar selección del proyecto" Command="{Binding RemoveCommand}"/>
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem x:Name="ShowExplorerMenu" Header="Explorador" IsCheckable="True" IsChecked="True" Click="OnToggleExplorer"/>
                <MenuItem x:Name="ShowInspectorMenu" Header="Inspector" IsCheckable="True" IsChecked="True" Click="OnToggleInspector"/>
                <MenuItem Header="Restaurar disposición" Click="OnResetLayout"/>
                <Separator/>
                <MenuItem Header="Encuadrar" Click="OnFit"/>
                <MenuItem Header="Perspectiva" Click="OnPerspective"/>
                <MenuItem Header="Ortográfica isométrica" Click="OnOrthographic"/>
                <MenuItem Header="Superior" Click="OnTop"/>
                <MenuItem Header="Frontal" Click="OnFront"/>
                <MenuItem Header="Malla alámbrica" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=WireframeToggle}"/>
            </MenuItem>

            <MenuItem Header="_Modelado">
                <MenuItem Header="Centrar selección en XY" Command="{Binding CenterSelectionCommand}"/>
            </MenuItem>

            <MenuItem Header="_Grabado">
                <MenuItem Header="Consultar LaserPecker por Bluetooth" Command="{Binding ProbeBluetoothCommand}"/>
                <Separator/>
                <MenuItem Header="Abrir G-code…" Command="{Binding OpenToolpathCommand}"/>
                <MenuItem Header="Exportar G-code genérico…" Command="{Binding ExportToolpathCommand}"
                          IsEnabled="{Binding HasToolpath}"/>
                <MenuItem Header="Quitar trayectoria" Command="{Binding RemoveToolpathCommand}" IsEnabled="{Binding HasToolpath}"/>
                <MenuItem Header="Encuadrar campo de grabado" Click="OnFitField" IsEnabled="{Binding ShowField}"/>
                <MenuItem Header="Elegir cara de grabado" Click="OnSelectFace"/>
                <MenuItem Header="Usar cara más alta de la pieza" Click="OnHighestFace"/>
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="Abrir carpeta de diagnóstico" Click="OnOpenLogs"/>
            </MenuItem>

        </Menu>

        <TabControl Grid.Row="2" Padding="8" Background="{StaticResource PanelBrush}"
                    AutomationProperties.Name="Herramientas de Studio">
            <TabItem Header="Escena">
            <DockPanel Margin="12,0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ui:Button Content="Encuadrar" Click="OnFit" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="WireframeToggle" Content="Alámbrica" Checked="OnWireframe" Unchecked="OnWireframe"
                                  Padding="10,5" Margin="0,0,8,0"/>
                    <ui:Button Content="Perspectiva" Click="OnPerspective" Margin="0,0,8,0"/>
                    <ui:Button Content="Ortográfica" Click="OnOrthographic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Importar STL" Background="{StaticResource GreenBrush}" Foreground="#15231D"
                               Command="{Binding ImportCommand}" Margin="0,0,8,0">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24"/></ui:Button.Icon>
                    </ui:Button>
                    <ComboBox SelectedIndex="{Binding UnitIndex}" ToolTip="Unidades de origen del próximo STL"
                              AutomationProperties.Name="Unidades de importación STL"
                              MinWidth="72" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="mm"/>
                        <ComboBoxItem Content="cm"/>
                        <ComboBoxItem Content="m"/>
                        <ComboBoxItem Content="in"/>
                    </ComboBox>
                    <ui:Button Content="Abrir" Command="{Binding OpenCommand}" Margin="0,0,8,0"/>
                    <ui:Button Content="Guardar" Command="{Binding SaveCommand}"/>
                    <ui:Button Content="Deshacer" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="{Binding UndoDescription}" Margin="6,0"/>
                    <ui:Button Content="Rehacer" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
                </StackPanel>
            </DockPanel>
            </TabItem>
            <TabItem Header="Campo LP2">
                <StackPanel Margin="12,5">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="LP2 · CAMPO" Style="{StaticResource PanelLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="Mostrar" IsChecked="{Binding ShowField}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Apoyo Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <local:NumericInput Text="{Binding SupportHeight, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0" AutomationProperties.Name="Plano de apoyo Z"/>
                    <TextBlock Text="Altura (mm)" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <local:NumericInput Text="{Binding FieldHeight, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,6,0"
                             AutomationProperties.Name="Altura del campo en milímetros"/>

                    <TextBlock Text="{Binding FieldSummary}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <ui:Button Content="Encuadrar campo" Click="OnFitField" IsEnabled="{Binding ShowField}"/>
                </WrapPanel>
                <WrapPanel Margin="0,5,0,0">
                    <ui:Button x:Name="SelectFaceButton" Content="Elegir cara" Click="OnSelectFace" Margin="0,0,6,0"/>
                    <ui:Button Content="Cara más alta" Click="OnHighestFace" Margin="0,0,6,0"/>
                    <ui:Button x:Name="ClearFaceButton" Content="Quitar referencia" Click="OnClearFace" IsEnabled="False" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FaceSummary" Text="Origen XY (0.0, 0.0) · Z 0" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="TrackPose" Content="Seguir pieza" IsChecked="True" Checked="OnTrackPose" Unchecked="OnTrackPose"
                              VerticalAlignment="Center"/>
                </WrapPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Colocación">
                <StackPanel Margin="12,5">
                    <WrapPanel>
                        <ComboBox x:Name="PlacementModePicker" SelectedIndex="0" Margin="0,0,6,0"
                                  SelectionChanged="OnPlacementModeChanged" AutomationProperties.Name="Modo de colocación">
                            <ComboBoxItem Content="Contorno exacto"/>
                            <ComboBoxItem Content="Rectángulo envolvente"/>
                            <ComboBoxItem Content="Contornos por pieza"/>
                            <ComboBoxItem Content="Sección a Z"/>
                        </ComboBox>
                        <ComboBox x:Name="GuideScope" SelectedIndex="0" SelectionChanged="OnPlacementModeChanged" Margin="0,0,6,0" AutomationProperties.Name="Alcance de guía">
                            <ComboBoxItem Content="Selección"/><ComboBoxItem Content="Toda la escena"/>
                        </ComboBox>
                        <ComboBox x:Name="GuideReference" SelectedIndex="0" SelectionChanged="OnPlacementModeChanged" Margin="0,0,6,0" AutomationProperties.Name="Referencia de guía">
                            <ComboBoxItem Content="Superior"/><ComboBoxItem Content="Inferior"/><ComboBoxItem Content="Apoyo"/><ComboBoxItem Content="Z personalizado"/><ComboBoxItem Content="Cara elegida"/>
                        </ComboBox>
                        <local:NumericInput x:Name="GuideZ" Text="0" Width="70" TextChanged="OnGuideHeight" AutomationProperties.Name="Altura de sección o referencia Z"/>
                        <ui:Button Content="Actualizar" Click="OnGeneratePlacement" Margin="0,0,6,0"/>
                        <ui:Button x:Name="ExportPlacement" Content="Exportar guía G-code" IsEnabled="False"
                                   Click="OnExportPlacement" Margin="0,0,6,0"/>
                        <TextBox x:Name="UsbPort" Text="{Binding UsbPortName, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,6,0" AutomationProperties.Name="Puerto USB"/>
                        <ui:Button x:Name="LivePreview" Content="Previsualizar en vivo · USB" Click="OnLivePreview" Background="{StaticResource GreenBrush}" Foreground="#111318" Margin="0,0,6,0"/>
                        <ui:Button x:Name="StopPreview" Content="Detener proyección" Click="OnStopPreview" IsEnabled="False" Margin="0,0,6,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="PlacementSummary" Text="Selecciona una malla y genera su guía."
                               Style="{StaticResource PanelText}" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="Mover encuadre · paso 1 mm" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:Button Content="X −" Tag="-1,0" Click="OnMovePreview" Margin="0,0,4,0"/>
                        <ui:Button Content="X +" Tag="1,0" Click="OnMovePreview" Margin="0,0,4,0"/>
                        <ui:Button Content="Y −" Tag="0,-1" Click="OnMovePreview" Margin="0,0,4,0"/>
                        <ui:Button Content="Y +" Tag="0,1" Click="OnMovePreview" Margin="0,0,4,0"/>
                        <ui:Button Content="Restablecer desplazamiento" Tag="0,0" Click="OnMovePreview" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PreviewOffset" Text="ΔX 0 · ΔY 0 mm" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock x:Name="UsbPreviewStatus" Text="Sin emisión. Inicia en vivo para seguir cambios de pose y encuadre · LP2 3.16 · nivel 1 · máximo 60 s · campo USB 100 × 100 mm."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="G-CODE · SIMULACIÓN" Style="{StaticResource PanelLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ui:Button DockPanel.Dock="Left" Content="Abrir" Command="{Binding OpenToolpathCommand}" Margin="0,0,6,0"/>
                    <ui:Button DockPanel.Dock="Left" x:Name="PlayButton" Content="Reproducir" Click="OnTogglePlayback"
                               IsEnabled="{Binding HasToolpath}" Margin="0,0,6,0"/>
                    <ui:Button DockPanel.Dock="Left" x:Name="AlignmentButton" Content="Prueba de posición"
                               Click="OnAlignmentTest" IsEnabled="{Binding HasToolpath}" Margin="0,0,6,0"
                               ToolTip="Reproduce la trayectoria y sus límites en el visor, sin emisión."/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ToolpathSummary}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Slider x:Name="PlaybackSlider" Minimum="0" Maximum="1" IsEnabled="{Binding HasToolpath}"
                            VerticalAlignment="Center" ValueChanged="OnPlaybackPosition" AutomationProperties.Name="Posición de simulación"/>
                </DockPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Diseño">
                <WrapPanel Margin="12,5">
                    <ui:Button Content="Añadir imagen a pieza" Command="{Binding AddImageCommand}" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Designs}" SelectedItem="{Binding SelectedDesign}" DisplayMemberPath="Name" Width="160" AutomationProperties.Name="Diseño seleccionado"/>
                    <ui:Button Content="Quitar diseño" Command="{Binding RemoveDesignCommand}" Margin="6,0"/>
                    <ui:Button Content="Generar UV automático" Command="{Binding GenerateUvCommand}" Margin="0,0,6,0"/>
                    <CheckBox Content="Desarrollar cilindro" IsChecked="{Binding DevelopCylinder}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ui:Button Content="Preparar raster" Command="{Binding PrepareRasterCommand}" Margin="0,0,6,0"/>
                    <ui:Button Content="Exportar raster PNG" Command="{Binding ExportRasterCommand}"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="Preparación">
                <WrapPanel Margin="12,5">
                    <TextBlock Text="Potencia / profundidad / pasadas" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <local:NumericInput Text="{Binding EngravingPower, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.Name="Potencia de grabado explícita"/>
                    <local:NumericInput Text="{Binding EngravingDepth, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.Name="Profundidad explícita"/>
                    <local:NumericInput Text="{Binding EngravingRepeats, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.Name="Pasadas de grabado"/>
                    <ui:Button Content="Simular trabajo raster" Command="{Binding SimulateRasterCommand}" Margin="6,0"/>
                    <ui:Button Content="Importar mediciones de calibración" Command="{Binding ImportCalibrationCommand}"/>
                    <ui:Button Content="Cargar perfil" Command="{Binding LoadCalibrationCommand}" Margin="6,0"/>
                    <TextBox Text="{Binding SetupFingerprint, UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Identificador de la configuración física actual" AutomationProperties.Name="Configuración física actual"/>
                    <CheckBox Content="Usar registro medido" IsChecked="{Binding UseMeasuredCalibration}" VerticalAlignment="Center" Margin="6,0"/>
                    <ui:Button Content="Cargar aceptación física" Command="{Binding LoadEngravingValidationCommand}" Margin="6,0"/>
                    <ui:Button Content="Grabar en LP2" Command="{Binding StartRasterCommand}" IsEnabled="{Binding CanEngraveReal}" ToolTip="Pendiente de prueba física supervisada y perfil óptico validado" Margin="6,0"/>
                    <TextBlock Text="{Binding PreparationStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0"/>
                </WrapPanel>
            </TabItem>
            <TabItem Header="Accesorio LP2">
                <StackPanel Margin="12,5">
                    <WrapPanel>
                        <ComboBox SelectedIndex="{Binding AccessoryIndex}" Width="145" AutomationProperties.Name="Modo Electric Supporting Track">
                            <ComboBoxItem Content="Cilindro"/><ComboBoxItem Content="Avance plano"/><ComboBoxItem Content="Carrito"/>
                        </ComboBox>
                        <TextBlock Text="Diámetro · ordenado · medido · deseado · sentido ±1" VerticalAlignment="Center" Margin="6,0"/>
                        <local:NumericInput Text="{Binding AccessoryDiameter, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Diámetro medido"/>
                        <local:NumericInput Text="{Binding CommandedTravel, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Recorrido ordenado"/>
                        <local:NumericInput Text="{Binding MeasuredTravel, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Recorrido medido"/>
                        <local:NumericInput Text="{Binding DesiredTravel, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Recorrido deseado"/>
                        <local:NumericInput Text="{Binding TravelDirection, UpdateSourceTrigger=PropertyChanged}" Width="45" AutomationProperties.Name="Sentido de avance"/>
                        <ui:Button Content="Simular recorrido" Command="{Binding SimulateAccessoryCommand}" Margin="6,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AccessorySummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Movimiento físico bloqueado: accesorio sin conectar y secuencias de los tres modos pendientes de verificar." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Dispositivo">
                <WrapPanel Margin="12,5">
                    <TextBox Text="{Binding BluetoothName, UpdateSourceTrigger=PropertyChanged}" Width="175" Margin="0,0,6,0"
                             AutomationProperties.Name="Nombre Bluetooth de LaserPecker"/>
                    <TextBox Text="{Binding UsbPortName, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="Puerto USB del dispositivo" Margin="6,0"/>
                    <ui:Button Content="Consultar USB" Command="{Binding ProbeUsbCommand}" Margin="0,0,8,0"/>
                    <ui:Button Content="Consultar BLE" Command="{Binding ProbeBluetoothCommand}"/>
                    <ui:Button Content="Diagnóstico" Click="OnOpenLogs" Margin="6,0,0,0"/>
                </WrapPanel>
            </TabItem>
        </TabControl>

        <Grid x:Name="WorkspaceGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="280" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ExplorerDock" Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="EXPLORADOR DEL PROYECTO" Style="{StaticResource PanelLabel}"/>
                        <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" FontSize="17" Margin="0,12,0,18"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentTitle}"/>
                        <TextBlock Text="Mallas importadas" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Unidad del proyecto · mm" Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,0"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8">
                        <TextBlock Text="Diseños de superficie" Foreground="{StaticResource MutedBrush}"/>
                        <ListBox ItemsSource="{Binding Designs}" SelectedItem="{Binding SelectedDesign}" DisplayMemberPath="Name" MaxHeight="160" AutomationProperties.Name="Diseños del proyecto"/>
                    </StackPanel>
                    <ListBox x:Name="ProjectTree" ItemsSource="{Binding Models}" SelectionMode="Extended" SelectionChanged="OnTreeSelection" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Mallas del proyecto">
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/></DataTemplate>
                        </GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3B3517"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                                    <DataTrigger Binding="{Binding Model.Visible}" Value="False"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Name}">
                                    <Button DockPanel.Dock="Right" Padding="3" ToolTip="Mostrar / ocultar" AutomationProperties.Name="Alternar visibilidad"
                                            Command="{Binding DataContext.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><ui:SymbolIcon Symbol="Eye24"/></Button>
                                    <Button DockPanel.Dock="Right" Padding="3" ToolTip="Bloquear / desbloquear" AutomationProperties.Name="Alternar bloqueo"
                                            Command="{Binding DataContext.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><ui:SymbolIcon Symbol="LockClosed24"/></Button>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Cube24" Foreground="{StaticResource GreenBrush}"
                                                   Margin="0,0,8,0" FontSize="15"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource DividerBrush}"/>
            <Grid Grid.Column="2">
                <hx:Viewport3DX x:Name="Viewport" BackgroundColor="#171A21" ModelUpDirection="0,0,1"
                    ShowCoordinateSystem="True" ShowViewCube="True" IsHitTestVisible="True"
                    EnableMouseButtonHitTest="False" PreviewMouseLeftButtonDown="OnPick"
                    PreviewMouseRightButtonDown="OnObjectMenuDown" PreviewMouseRightButtonUp="OnObjectMenuUp"
                    PreviewMouseMove="OnObjectMenuMove" PreviewMouseLeftButtonUp="OnPointerEditUp" AllowDrop="True" Drop="OnDropFiles" PreviewDragOver="OnImageDragOver">
                    <hx:Viewport3DX.Resources>
                        <ContextMenu x:Key="ObjectMenu" Placement="MousePoint">
                            <MenuItem Header="{Binding SelectionSummary}" IsEnabled="False"/>
                            <MenuItem Header="Transformar">
                                <MenuItem Header="Mover XY" Tag="XY" Click="OnMenuTool"/><MenuItem Header="Girar Z" Tag="RZ" Click="OnMenuTool"/>
                                <MenuItem Header="Escala uniforme" Tag="Escala" Click="OnMenuTool"/><MenuItem Header="Restablecer pose" Command="{Binding ResetPoseCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Alinear y distribuir">
                                <MenuItem Header="Centrar en XY" Command="{Binding CenterSelectionCommand}"/>
                                <MenuItem Header="Apoyar sobre plano" Command="{Binding SupportSelectionCommand}"/>
                                <MenuItem Header="Alinear centros X" Command="{Binding AlignXCommand}"/><MenuItem Header="Alinear centros Y" Command="{Binding AlignYCommand}"/>
                                <MenuItem Header="Distribuir X · 5 mm" Command="{Binding DistributeXCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Organizar">
                                <MenuItem Header="Agrupar" Command="{Binding GroupSelectionCommand}"/><MenuItem Header="Desagrupar" Command="{Binding UngroupSelectionCommand}"/>
                                <MenuItem Header="Bloquear / desbloquear" Command="{Binding ToggleLockCommand}"/><MenuItem Header="Mostrar / ocultar" Command="{Binding ToggleVisibilityCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Duplicar selección" Command="{Binding DuplicateCommand}"/>
                            <MenuItem Header="Encuadrar selección" Click="OnFitSelection"/>
                            <MenuItem Header="Previsualizar selección en LP2" Click="OnLivePreview"/>
                            <Separator/><MenuItem Header="Quitar de escena" Command="{Binding RemoveCommand}"/>
                        </ContextMenu>
                        <ContextMenu x:Key="BackgroundMenu" Placement="MousePoint">
                            <MenuItem Header="Importar STL…" Command="{Binding ImportCommand}"/>
                            <MenuItem Header="Seleccionar todo" Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="Encuadrar escena" Click="OnFit"/>
                            <MenuItem Header="Vista superior y reglas" Click="OnTop"/>
                        </ContextMenu>
                    </hx:Viewport3DX.Resources>
                    <hx:AmbientLight3D Color="#606978"/>
                    <hx:DirectionalLight3D Direction="1,-2,-3" Color="#FFFFFF"/>
                    <hx:DirectionalLight3D Direction="-2,1,-1" Color="#7481A0"/>
                    <hx:LineGeometryModel3D x:Name="GridLines" Color="#3D4755" Thickness="0.7" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="AxisX" Color="#E7828C" Thickness="1.5" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="AxisY" Color="#8CE1B7" Thickness="1.5" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="AxisZ" Color="#AB99F5" Thickness="1.5" IsHitTestVisible="False"/>
                    <hx:BillboardTextModel3D x:Name="GridLabels" FixedSize="True" IsHitTestVisible="False"/>
                    <hx:GroupModel3D x:Name="Scene"/>
                    <hx:GroupModel3D x:Name="DesignScene"/>
                    <hx:LineGeometryModel3D x:Name="SelectionGizmo" Color="#FDD800" Thickness="1.6" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="GizmoX" Color="#FF727C" Thickness="3" DepthBias="-500" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="GizmoY" Color="#57D69B" Thickness="3" DepthBias="-500" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="GizmoZ" Color="#79B8FF" Thickness="3" DepthBias="-500" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="Measurement" Color="#D6A8FF" Thickness="2" IsHitTestVisible="False"/>
                    <hx:MeshGeometryModel3D x:Name="FieldSides" IsTransparent="True" CullMode="None" IsHitTestVisible="False"/>
                    <hx:MeshGeometryModel3D x:Name="FieldBelow" IsTransparent="True" CullMode="None" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="FieldOutline" Color="#668779B5" Thickness="1" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="FieldSection" Color="#DCC1F3" Thickness="1.1" IsHitTestVisible="False"/>
                    <hx:LineGeometryModel3D x:Name="PlacementOutline" Color="#79B8FF" Thickness="3"
                                            DepthBias="-100" IsHitTestVisible="False"/>
                    <hx:GroupModel3D x:Name="PlacedToolpath">
                        <hx:LineGeometryModel3D x:Name="TravelPath" Color="#72859B" Thickness="1.2" IsHitTestVisible="False"/>
                        <hx:LineGeometryModel3D x:Name="BurnPath" Color="#FFC274" Thickness="2" IsHitTestVisible="False"/>
                        <hx:LineGeometryModel3D x:Name="ToolMarker" Color="#FFFFFF" Thickness="2.5" IsHitTestVisible="False"/>
                        <hx:LineGeometryModel3D x:Name="AlignmentGuide" Color="#A9FFE6" Thickness="1.5" IsHitTestVisible="False"/>
                    </hx:GroupModel3D>
                </hx:Viewport3DX>
                <Canvas x:Name="RulerCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed" Stroke="#FDD800" Fill="#22FDD800" StrokeThickness="1"/>
                </Canvas>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6" IsHitTestVisible="False"
                        Background="{StaticResource ChromeBrush}" CornerRadius="3">
                    <TextBlock x:Name="ProjectionLabel" Text="PERSPECTIVA" Style="{StaticResource PanelLabel}"/>
                </Border>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,16" IsHitTestVisible="False"
                        x:Name="EmptyScene" Background="{StaticResource PanelBrush}" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Espacio de trabajo 3D" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Elige las unidades e importa un STL." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource DividerBrush}"/>
            <Border x:Name="InspectorDock" Grid.Column="4" Background="{StaticResource PanelBrush}" Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox x:Name="EditToolPicker" SelectedIndex="0" SelectionChanged="OnToolChoice" AutomationProperties.Name="Herramienta de escena">
                            <ComboBoxItem Content="Mover XY" Tag="XY"/><ComboBoxItem Content="Mover X" Tag="X"/><ComboBoxItem Content="Mover Y" Tag="Y"/><ComboBoxItem Content="Mover Z" Tag="Z"/>
                            <ComboBoxItem Content="Girar X" Tag="RX"/><ComboBoxItem Content="Girar Y" Tag="RY"/><ComboBoxItem Content="Girar Z" Tag="RZ"/>
                            <ComboBoxItem Content="Escala uniforme" Tag="Escala"/><ComboBoxItem Content="Medir entre puntos" Tag="Medir"/><ComboBoxItem Content="Mover diseño sobre superficie" Tag="Diseño"/>
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding PivotIndex}" Margin="0,4" AutomationProperties.Name="Pivote de transformación">
                            <ComboBoxItem Content="Pivote: centro de selección"/><ComboBoxItem Content="Pivote: objeto activo"/>
                            <ComboBoxItem Content="Pivote: origen"/><ComboBoxItem Content="Pivotes individuales"/>
                        </ComboBox>
                        <CheckBox x:Name="SelectThrough" Content="Seleccionar a través" ToolTip="Rectángulo: izquierda a derecha contiene; derecha a izquierda intersecta" Margin="0,4"/>
                        <CheckBox x:Name="SnapMove" Content="Ajustar a 1 mm" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ToolSummary" Text="Arrastra selección · Ctrl+clic añade" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INSPECTOR" Style="{StaticResource PanelLabel}" Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Text="Selecciona una malla para ver sus propiedades." Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" x:Name="EmptyInspector"/>
                            <StackPanel x:Name="Inspector" Visibility="Collapsed">
                                <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold"
                                           Style="{StaticResource PanelText}"/>
                                <TextBlock Text="Dimensiones en escena" Style="{StaticResource InspectorLabel}"/>
                                <TextBlock Text="{Binding WorldDimensions}" Style="{StaticResource PanelText}"/>
                                <Expander Header="Geometría y estadísticas" Margin="0,8"><StackPanel>
                                <TextBlock Text="Dimensiones locales (mm)" Style="{StaticResource InspectorLabel}"/>
                                <TextBlock Text="{Binding Selected.Dimensions}" Style="{StaticResource PanelText}"/>
                                <DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="Renombrar" Command="{Binding RenameSelectionCommand}"/>
                                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nuevo nombre de selección"/></DockPanel>
                                <TextBlock Text="Límites locales (mm)" Style="{StaticResource InspectorLabel}"/>
                                <TextBlock Text="{Binding Selected.Bounds}" Style="{StaticResource PanelText}"/>
                                <TextBlock Text="Centroide superficial (mm)" Style="{StaticResource InspectorLabel}"/>
                                <TextBlock Text="{Binding Selected.Centroid}" Style="{StaticResource PanelText}"/>
                                <TextBlock Text="{Binding Selected.Counts}" Style="{StaticResource PanelText}" Margin="0,10,0,16"/>
                                </StackPanel></Expander>
                                <Separator/>
                                <TextBlock Text="TRANSFORMACIÓN" Style="{StaticResource PanelLabel}" Margin="0,10,0,8"/>
                                <TextBlock Text="Traslación X / Y / Z (mm)" Style="{StaticResource PanelText}" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <local:NumericInput x:Name="MoveX" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                             AutomationProperties.Name="Traslación X"/>
                                    <local:NumericInput Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                             AutomationProperties.Name="Traslación Y"/>
                                    <local:NumericInput Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Traslación Z"/>
                                </UniformGrid>
                                <TextBlock Text="Giro X / Y / Z (°)" Style="{StaticResource InspectorLabel}"/>
                                <UniformGrid Columns="3">
                                    <local:NumericInput Text="{Binding RotationX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giro X"/>
                                    <local:NumericInput Text="{Binding RotationY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giro Y"/>
                                    <local:NumericInput Text="{Binding Rotation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giro Z"/>
                                </UniformGrid>
                                <TextBlock Text="Escala uniforme" Style="{StaticResource InspectorLabel}"/>
                                <local:NumericInput Step="0.01" Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escala uniforme"/>
                                <TextBlock Text="{Binding WorldDimensions}" Style="{StaticResource PanelText}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource PanelText}" Margin="0,4,0,0"/>
                                <Separator Margin="0,12"/>
                                <Expander Header="Diseño de superficie" IsExpanded="False"><StackPanel>
                                <TextBlock Text="{Binding DesignSummary}" TextWrapping="Wrap"/>
                                <ComboBox SelectedIndex="{Binding DesignMapping}" AutomationProperties.Name="Proyección de diseño" Margin="0,6">
                                    <ComboBoxItem Content="Planar"/><ComboBoxItem Content="Cilíndrica"/><ComboBoxItem Content="UV automático"/>
                                </ComboBox>
                                <TextBlock Text="Diseño: ancho / alto (mm)" Style="{StaticResource InspectorLabel}"/>
                                <UniformGrid Columns="2"><local:NumericInput Text="{Binding DesignWidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ancho del diseño"/>
                                    <local:NumericInput Text="{Binding DesignHeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Alto del diseño"/></UniformGrid>
                                <CheckBox Content="Mantener proporción" IsChecked="{Binding LockDesignAspect}" Margin="0,5"/>
                                <TextBlock Text="Diseño: origen local XYZ" Style="{StaticResource InspectorLabel}"/>
                                <UniformGrid Columns="3"><local:NumericInput Text="{Binding DesignX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Diseño X"/>
                                    <local:NumericInput Text="{Binding DesignY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Diseño Y"/>
                                    <local:NumericInput Text="{Binding DesignZ, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Diseño Z"/></UniformGrid>
                                <TextBlock Text="Diseño: giro / opacidad" Style="{StaticResource InspectorLabel}"/>
                                <UniformGrid Columns="2"><local:NumericInput Text="{Binding DesignAngle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giro del diseño"/>
                                    <local:NumericInput Step="0.05" Text="{Binding DesignOpacity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Opacidad del diseño"/></UniformGrid>
                                <Expander Header="Cilindro y atlas UV" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Normal / eje local XYZ"/>
                                        <UniformGrid Columns="3"><local:NumericInput Step="0.1" Text="{Binding DesignNormalX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Normal o eje X"/>
                                            <local:NumericInput Step="0.1" Text="{Binding DesignNormalY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Normal o eje Y"/>
                                            <local:NumericInput Step="0.1" Text="{Binding DesignNormalZ, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Normal o eje Z"/></UniformGrid>
                                        <TextBlock Text="Recorte normalizado: izquierda / arriba / derecha / abajo" TextWrapping="Wrap" Margin="0,5"/>
                                        <UniformGrid Columns="4"><local:NumericInput Step="0.01" Text="{Binding CropLeft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recorte izquierda"/>
                                            <local:NumericInput Step="0.01" Text="{Binding CropTop, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recorte arriba"/>
                                            <local:NumericInput Step="0.01" Text="{Binding CropRight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recorte derecha"/>
                                            <local:NumericInput Step="0.01" Text="{Binding CropBottom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recorte abajo"/></UniformGrid>
                                        <TextBlock Text="Radio / costura (mm / °)"/><UniformGrid Columns="2">
                                            <local:NumericInput Text="{Binding CylinderRadius, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Radio del cilindro"/>
                                            <local:NumericInput Text="{Binding CylinderSeam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Costura angular"/></UniformGrid>
                                        <CheckBox Content="Mostrar distorsión de área UV" IsChecked="{Binding ShowUvDistortion}" Margin="0,5"/>
                                        <Canvas x:Name="AtlasCanvas" Width="240" Height="180" Background="#101216" ClipToBounds="True" Margin="0,6"/>
                                        <TextBlock Text="Isla / desplazamiento UV"/>
                                        <UniformGrid Columns="3"><local:NumericInput Text="{Binding SelectedChart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Isla UV"/>
                                            <local:NumericInput Step="0.01" Text="{Binding ChartX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Isla UV X"/>
                                            <local:NumericInput Step="0.01" Text="{Binding ChartY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Isla UV Y"/></UniformGrid>
                                        <TextBlock Text="Escala / giro de isla"/>
                                        <UniformGrid Columns="2"><local:NumericInput Step="0.01" Text="{Binding ChartScale, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escala de isla"/>
                                            <local:NumericInput Text="{Binding ChartAngle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Giro de isla"/></UniformGrid>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Raster preparado"><Image Source="{Binding RasterPreview}" Height="180" Stretch="Uniform"/></Expander>
                                </StackPanel></Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="4" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True" Margin="14,0">
                <ui:Button x:Name="StatusStopPreview" DockPanel.Dock="Left" Content="Detener LP2" Click="OnStopPreview"
                           Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceStatus}" Foreground="{StaticResource GreenBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="Órbita: botón derecho · Pan: Mayús + botón derecho · Zoom: rueda"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"/>
                <ui:Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <ProgressBar DockPanel.Dock="Right" Width="56" Height="4" Margin="8,0" VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Status}"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
