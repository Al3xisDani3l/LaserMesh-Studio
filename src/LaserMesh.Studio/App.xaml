<Application x:Class="LaserMesh.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BaseBrush" Color="#101216"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#1B1E24"/>
            <SolidColorBrush x:Key="ChromeBrush" Color="#242933"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#343B47"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E7EAF0"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#AAB3C0"/>
            <SolidColorBrush x:Key="GreenBrush" Color="#FDD800"/>
            <SolidColorBrush x:Key="PurpleBrush" Color="#AAB3C0"/>
            <Style x:Key="PanelLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
